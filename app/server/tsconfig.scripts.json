// Сквозные наборы в `scripts/` не попадали под проверку типов: основной
// tsconfig собирает только `src`. Из-за этого синтаксическая ошибка в тесте
// обнаруживалась лишь при запуске, а «проверка типов чистая» перед коммитом
// ничего о тестах не говорила.
//
//   npx tsc -p tsconfig.scripts.json
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "lib": ["ES2023", "DOM"]
  },
  "include": ["scripts"]
}
